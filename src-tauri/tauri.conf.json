{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaia",
  "version": "0.1.0",
  "identifier": "ai.gaia.desktop",
  "build": {
    "frontendDist": "../frontend/build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ./frontend start",
    "beforeBuildCommand": "npm --prefix ./frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gaia",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
